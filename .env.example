# Copy to .env for local dev. Never commit real credentials.
# Optional, server-only; increases the GitHub public PR API quota.
GITHUB_TOKEN=
# Server endpoint only, not a credential. Keep the testnet default for this demo.
OUTLAYER_API_BASE=https://testnet-api.outlayer.ai
# Empty uses in-memory PGLite, shared with auth; resets on server restart.
# Set a Postgres connection string for persistence (also used by demo:seed's server).
DATABASE_URL=
# Production: set a stable random secret (at least 32 characters) and public URL.
# Local dev otherwise uses a process-stable generated secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
# UNSAFE for real identities: explicitly opt in only for demos.
# npm run dev defaults this to true locally, false on Vercel/NODE_ENV=production.
# Build/preview/production never default it on. Explicit true enables it anywhere.
MAINTPAY_DEMO_AUTO_VERIFY=true
DEMO_PASSWORD=MaintPay-demo-2026!
# Production OAuth broker client, registered for the deployed callback URLs.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
